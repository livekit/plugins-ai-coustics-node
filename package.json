{
  "name": "@livekit/plugins-ai-coustics",
  "version": "0.3.0",
  "license": "SEE LICENSE IN https://livekit.io/legal/terms-of-service",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    "import": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "require": {
      "types": "./dist/index.d.cts",
      "default": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "repository": "git@github.com:livekit/plugins-ai-coustics-node",
  "scripts": {
    "prepublishOnly": "pnpm run build",
    "build": "tsup",
    "dev": "tsup --watch",
    "ts:check": "tsc --noEmit"
  },
  "engines": {
    "node": ">= 18"
  },

  "dependencies": {
    "@ubjs/node": "0.31.0-3",
    "@ubjs/core": "0.31.0-3",
    "pino": "9.13.1",
    "pino-pretty": "^13.0.0"
  },
  "devDependencies": {
    "tsup": "^8.4.0",
    "typescript": "5.9.3"
  },
  "optionalDependencies": {
    "@livekit/plugins-ai-coustics-aarch64-apple-darwin":      "0.3.0",
    "@livekit/plugins-ai-coustics-x86_64-apple-darwin":       "0.3.0",
    "@livekit/plugins-ai-coustics-x86_64-unknown-linux-gnu":  "0.3.0",
    "@livekit/plugins-ai-coustics-aarch64-unknown-linux-gnu": "0.3.0",
    "@livekit/plugins-ai-coustics-x86_64-pc-windows-msvc":    "0.3.0"
  },
  "peerDependencies": {
    "@livekit/rtc-node": "^0.13.24",
    "@livekit/agents": "^1.0.43"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "@ffmpeg-installer/linux-x64",
      "esbuild",
      "protobufjs",
      "sharp"
    ]
  }
}
